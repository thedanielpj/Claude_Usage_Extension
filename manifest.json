{
  "manifest_version": 3,
  "name": "Usage Overlay for Claude",
  "version": "0.1.0",
  "description": "Independent overlay on claude.ai showing your session and weekly usage limits with reset countdowns. Not affiliated with Anthropic.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/usage.js", "src/flame.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/inter-latin-wght-normal.woff2", "fonts/bangers-latin-400-normal.woff2"],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "action": {
    "default_title": "Usage Overlay for Claude",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
